// tmux-leap config
// Full reference copy of this file: /usr/share/tmux-leap/config.ron.template
//
// Uncomment a line to change it. Everything except `projects` is optional.
#![enable(implicit_some)]

(
    // Marks every project that has an open tmux session with a green dot and a
    // bold folder name (the rest are dimmed), and shows a Claude Code icon
    // after sessions that run Claude: one icon per distinct state (needs
    // input, just finished, working), with a count when several panes share
    // one. State comes from the per-pane tmux option @claude_state, which a
    // Claude Code hook sets; without it every Claude pane shows as neutral.
    // On by default. Needs a Nerd Font for the icon.
    annotate_status: true,

    // Or run your own command instead: it must print "session_name<TAB>text"
    // lines, one per session. Takes priority over annotate_status.
    // Overridden by $TMUX_LEAP_ANNOTATE.
    // annotate: "tmux list-sessions -F \"#{session_name}\\t#{session_windows} windows\"",

    // Live preview on the right: the screen of the highlighted project's tmux
    // session. The preview hides itself for projects without a session.
    // On by default.
    preview_screen: true,

    // Or your own preview command instead. In it {4} is the project's
    // absolute path and {3} its tmux session name. Takes priority over
    // preview_screen.
    // preview_command: "ls -la {4}",

    // ctrl-o in the picker opens the project and types this command into a
    // fresh pane (the first pane of a new session, or a new window of an open
    // one). It runs through your interactive shell. Overridden by
    // $TMUX_LEAP_LAUNCH.
    // launch: "claude",

    // Paths longer than this are cut from the left with "…" so the folder
    // name stays visible. Default 80. Overridden by $TMUX_LEAP_PATH_WIDTH.
    // path_width: 80,

    projects: [
{projects}    ],
)
