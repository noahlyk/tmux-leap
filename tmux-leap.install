post_install() {
    echo ""
    echo "==> tmux-leap installed successfully!"
    echo ""
    echo "==> Getting Started:"
    echo ""
    echo "    1. Add your project directories:"
    echo "       tmux-leap add ~/Code"
    echo "       tmux-leap add ."
    echo ""
    echo "    2. Start jumping through projects:"
    echo "       tmux-leap                    # FZF through your projects"
    echo "       tmux-leap goto ~             # Go directly to home"
    echo "       tmux-leap goto ~/Code        # Go directly to Code directory"
    echo ""
    echo "==> Picker keys:"
    echo "       enter   open the project"
    echo "       tab     mark several projects"
    echo "       ctrl-x  kill the tmux sessions of the marked (or highlighted) projects"
    echo "       ctrl-t  show only projects with an open session"
    echo "       ctrl-o  open and run the 'launch' command from your config"
    echo ""
    echo "==> The picker marks open sessions (green dot), shows a Claude Code"
    echo "    status icon per session, and previews the highlighted session."
    echo "    Toggle these in config.ron: annotate_status, preview_screen."
    echo ""
    echo "==> Other useful commands:"
    echo "       tmux-leap list                # List all projects"
    echo "       tmux-leap delete              # Remove a project"
    echo "       tmux-leap edit                # Edit your config.ron"
    echo ""
    echo "==> Config lives at ~/.config/tmux-leap/config.ron — every option is"
    echo "    documented right there in the file."
    echo ""
    echo "==> Shell completions have been installed system-wide!"
    echo ""
    echo "==> For more info: https://github.com/noahlyk/tmux-leap"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> tmux-leap upgraded successfully!"
    echo ""
    echo "==> Breaking change in this version:"
    echo "    • Config moved from ~/.projects and ~/.projects_cache to"
    echo "      ~/.config/tmux-leap/config.ron and ~/.config/tmux-leap/.projects_cache"
    echo "    • On first run, tmux-leap copies your existing ~/.projects into the"
    echo "      new config.ron automatically. Your old ~/.projects and"
    echo "      ~/.projects_cache are left in place, untouched."
    echo "    • The project list now lives alongside settings in one file. Run"
    echo "      'tmux-leap edit' to see it. The TMUX_LEAP_ANNOTATE, TMUX_LEAP_LAUNCH"
    echo "      and TMUX_LEAP_PATH_WIDTH environment variables still work and win"
    echo "      over the matching config.ron settings."
    echo ""
    echo "==> New picker keys: tab (mark), ctrl-x (kill sessions), ctrl-t (open"
    echo "    sessions only), ctrl-o (open and run your 'launch' command)."
    echo ""
    echo "==> For more info: https://github.com/noahlyk/tmux-leap"
    echo ""
}
